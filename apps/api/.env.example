# Public API URL used by Swagger metadata
API_PUBLIC_URL=http://localhost:3001

# Allowed browser origins, comma-separated in production
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=

# Postgres for Prisma
# Use pooled URLs for runtime (Neon/Supabase pooler).
WEB3CV_DATABASE_URL=
WEB3JOBS_DATABASE_URL=

# Use direct, non-pooled URLs for Prisma migrations.
WEB3CV_DIRECT_URL=
WEB3JOBS_DIRECT_URL=

# Redis
# Prefer REDIS_URL for cloud providers. Use rediss:// when TLS is required.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Uploads
MAX_UPLOAD_BYTES=4194304

# Pinecone Config
PINECONE_API_KEY=
PINECONE_JOB_INDEX_NAME=
PINECONE_JOB_INDEX_HOST=
PINECONE_RESUME_INDEX_NAME=
PINECONE_RESUME_INDEX_HOST=
PINECONE_NAMESPACE=

# Embedding config
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Ai Service
OPENROUTER_API_KEY=
AI_MODEL=
AI_API_BASE_URL=
USE_V2_MATCHING=false
