generator client {
  provider      = "prisma-client-js"
  output        = "../apps/api/src/prisma/web3cv"
  binaryTargets = ["native", "darwin-arm64", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("WEB3CV_DATABASE_URL")
}

/// 用户表，记录所有注册用户的钱包地址及基础信息
model User {
  id           String        @id @default(cuid())
  address      String        @unique
  nickname     String?
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  nftProofs    NFTProof[]
}

/// 岗位表，记录所有招聘岗位信息
model Job {
  id                 String           @id @default(cuid())
  title              String
  description        String
  jobType            String
  weights            Json
  parsedRequirements Json
  vectorMetadata     Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applications       Application[]
  resumeAnalyses     ResumeAnalysis[]
}

/// 简历表，记录用户上传的简历
model Resume {
  id         String    @id @default(cuid())
  userId     String
  content    String
  title      String?
  filename   String?
  filetype   String?
  filesize   Int?
  parsedData Json?
  vectorId   String?
  status     String?   @default("pending")
  createdAt  DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
}

/// 简历分析表，记录简历与岗位的匹配分析结果
model ResumeAnalysis {
  id              String   @id @default(cuid())
  jobId           String
  resumeContent   String
  parsedResume    Json
  totalScore      Float
  skillScore      Float
  experienceScore Float
  matchingPoints  Json
  suggestions     Json
  recommended     Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

/// 投递记录表，记录用户对岗位的投递行为
model Application {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  status    String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

/// NFT证明表，记录用户的链上成就/组织等证明
model NFTProof {
  id       String   @id @default(cuid())
  userId   String
  nftType  String
  tokenId  String
  txHash   String
  mintedAt DateTime
  user     User     @relation(fields: [userId], references: [id])
}

/// 职位发布表 - 存储从其他招聘网站爬取的职位信息
model job_posting {
  topic_id             String   @id @db.VarChar(32)
  content              String?
  content2             String?
  content3             String?
  content5             String?
  email                String?  @db.VarChar(255)
  phone                String?  @db.VarChar(20)
  wechat               String?  @db.VarChar(50)
  telegram             String?  @db.VarChar(50)
  position_name        String   @db.VarChar(100)
  position_id          BigInt?
  view_count           Int?     @default(0)
  applied              Boolean? @default(false)
  apply_count          Int?     @default(0)
  create_time          BigInt?
  url                  String?
  work_type_id         Int?
  work_type_name       String?  @db.VarChar(50)
  office_mode_id       Int?
  office_mode_name     String?  @db.VarChar(50)
  company              String   @db.VarChar(100)
  company_introduction String?
  company_size_name    String?  @db.VarChar(50)
  company_logo         String?
  company_website      String?
  company_id           BigInt?
  min_salary           Decimal? @db.Decimal(10, 2)
  max_salary           Decimal? @db.Decimal(10, 2)
  lever_id             Int?
  lever_name           String?  @db.VarChar(50)
  location             String?  @db.VarChar(255)
  base                 String?  @db.VarChar(50)
  ffrom                String?  @db.VarChar(50)
  status               Int?     @default(0)
}

/// 职位标签关系表 - 存储职位与标签的多对多关系
model job_tag_relation {
  topic_id String  @db.VarChar(32)
  tag_id   BigInt
  ffrom    String? @db.VarChar(50)

  @@id([topic_id, tag_id])
}

/// 标签表 - 存储职位相关的标签信息
model tag {
  tag_id   BigInt  @id
  tag_name String  @db.VarChar(100)
  ffrom    String? @db.VarChar(50)
}

/// 发布岗位信息的用户信息表 - 存储发布岗位信息的用户的基本信息
model user_info {
  id             BigInt   @id
  nickname       String   @db.VarChar(255)
  avatar         String?
  small_avatar   String?
  topic_count    Int?     @default(0)
  comment_count  Int?     @default(0)
  fans_count     Int?     @default(0)
  follow_count   Int?     @default(0)
  score          Int?
  description    String?
  create_time    BigInt?
  wallet_address String?  @db.VarChar(255)
  ffrom          String?  @db.VarChar(50)
  followed       Boolean? @default(false)
}

model job_user_relation {
  topic_id String  @db.VarChar(32)
  user_id  BigInt
  ffrom    String? @db.VarChar(50)

  @@id([topic_id, user_id])
}
