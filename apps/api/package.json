{
  "name": "block-recruit-api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "node -r tsconfig-paths/register --import tsx src/index.ts",
    "dev:watch": "node -r tsconfig-paths/register --import tsx --watch src/index.ts",
    "generate-swagger": "tsx scripts/generate-swagger.js && cp swagger.json ../web/lib/swagger.json",
    "prisma:generate:web3cv": "prisma generate --schema=../../prisma/web3cv.prisma",
    "prisma:generate:web3jobs": "prisma generate --schema=../../prisma/web3jobs.prisma",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:job-resume-match": "node -r tsconfig-paths/register --import tsx src/test/job-resume-match-test.ts",
    "test:rag": "node -r tsconfig-paths/register --import tsx src/test/rag-test.ts",
    "test:resume-rag": "node -r tsconfig-paths/register --import tsx src/test/resume-rag-test.ts",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "update-api-client": "npm run generate-swagger && cd ../web && npm run generate-api"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@langchain/core": "^0.3.61",
    "@langchain/openai": "^0.5.15",
    "@pinecone-database/pinecone": "^6.0.0",
    "@prisma/client": "^5.0.0",
    "ethers": "^6.7.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.0",
    "koa": "^2.14.2",
    "koa-bodyparser": "^4.3.0",
    "koa-router": "^12.0.0",
    "koa2-swagger-ui": "^5.11.0",
    "langchain": "^0.0.94",
    "mammoth": "^1.6.0",
    "onnxruntime-node": "1.22.0-rev",
    "openai": "^5.8.2",
    "pdfjs-dist": "^3.11.174",
    "redis-mock": "^0.56.3",
    "serverless-http": "^3.2.0",
    "swagger-jsdoc": "^6.2.8",
    "tesseract.js": "^6.0.1",
    "transformers": "^3.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@huggingface/inference": "^4.0.5",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/koa": "^2.13.4",
    "@types/koa__cors": "^5.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-router": "^7.4.4",
    "@types/node": "^20.0.0",
    "@types/redis": "^4.0.11",
    "@types/redis-mock": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "4.0.0-beta1",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0"
  }
}