# PRIMUS
NEXT_PUBLIC_PRIMUS_APP_ID=
NEXT_PUBLIC_PRIMUS_SECRET=
NEXT_PUBLIC_PRIMUS_DIGREE_TEMPLATE_ID=
NEXT_PUBLIC_PRIMUS_CET_TEMPLATE_ID=
NEXT_PUBLIC_PRIMUS_USER_ADDRESS=

# API
# Local dev can omit NEXT_PUBLIC_API_URL and use /api/business proxy.
# Production should point to the deployed apps/api Vercel domain unless API is same-origin.
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://localhost:3001

# Supabase browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth Google OAuth
# 从 Google Cloud Console 获取: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# NextAuth/Auth.js 密钥 (运行 `openssl rand -base64 32` 生成)
AUTH_SECRET=your-auth-secret

# Auth.js URL (生产环境改为实际域名)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Backward-compatible aliases if old code or tooling still reads them
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
