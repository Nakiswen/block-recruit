generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 职位发布表 - 存储从其他招聘网站爬取的职位信息
model job_posting {
  topic_id             BigInt   @id                 // 主题ID，作为主键
  content              String?                      // 职位描述内容1
  content2             String?                      // 职位描述内容2
  content3             String?                      // 职位描述内容3
  content5             String?                      // 职位描述内容5
  email                String?  @db.VarChar(255)    // 联系邮箱
  phone                String?  @db.VarChar(20)     // 联系电话
  wechat               String?  @db.VarChar(50)     // 微信联系方式
  telegram             String?  @db.VarChar(50)     // Telegram联系方式
  position_name        String   @db.VarChar(100)    // 职位名称
  position_id          BigInt?                      // 职位ID
  view_count           Int?     @default(0)         // 职位浏览次数
  applied              Boolean? @default(false)     // 是否已申请
  apply_count          Int?     @default(0)         // 申请人数
  create_time          BigInt?                      // 职位创建时间戳
  url                  String?                      // 原始职位链接
  work_type_id         Int?                         // 工作类型ID
  work_type_name       String?  @db.VarChar(50)     // 工作类型名称（如：全职、兼职等）
  office_mode_id       Int?                         // 办公模式ID
  office_mode_name     String?  @db.VarChar(50)     // 办公模式名称（如：远程、现场等）
  company              String   @db.VarChar(100)    // 公司名称
  company_introduction String?                      // 公司介绍
  company_size_name    String?  @db.VarChar(50)     // 公司规模
  company_logo         String?                      // 公司logo URL
  company_website      String?                      // 公司官网
  company_id           BigInt?                      // 公司ID
  min_salary           Decimal? @db.Decimal(10, 2)  // 最低薪资
  max_salary           Decimal? @db.Decimal(10, 2)  // 最高薪资
  lever_id             Int?                         // 职级ID
  lever_name           String?  @db.VarChar(50)     // 职级名称（如：初级、中级、高级等）
  location             String?  @db.VarChar(255)    // 工作地点
  base                 String?  @db.VarChar(50)     // 基础信息
  ffrom                String?  @db.VarChar(50)     // 数据来源
  status               Int?     @default(0)         // 职位状态（0: 默认, 1: 已关闭等）
}

/// 职位标签关系表 - 存储职位与标签的多对多关系
model job_tag_relation {
  topic_id BigInt                                  // 职位主题ID
  tag_id   BigInt                                  // 标签ID
  ffrom    String? @db.VarChar(50)                 // 数据来源

  @@id([topic_id, tag_id])                         // 联合主键：职位ID + 标签ID
}

/// 标签表 - 存储职位相关的标签信息
model tag {
  tag_id   BigInt  @id                             // 标签ID，主键
  tag_name String  @db.VarChar(100)                // 标签名称
  ffrom    String? @db.VarChar(50)                 // 数据来源
}

/// 发布岗位信息的用户信息表 - 存储发布岗位信息的用户的基本信息
model user_info {
  id             BigInt   @id                      // 用户ID，主键
  nickname       String   @db.VarChar(255)         // 用户昵称
  avatar         String?                          // 用户头像URL
  small_avatar   String?                          // 用户小头像URL
  topic_count    Int?     @default(0)              // 发帖数量
  comment_count  Int?     @default(0)              // 评论数量
  fans_count     Int?     @default(0)              // 粉丝数量
  follow_count   Int?     @default(0)              // 关注数量
  score          Int?                              // 用户积分
  description    String?                          // 用户简介
  create_time    BigInt?                          // 账号创建时间戳
  wallet_address String?  @db.VarChar(255)         // 钱包地址
  ffrom          String?  @db.VarChar(50)          // 数据来源
  followed       Boolean? @default(false)          // 是否已关注
}

/// 用户表，记录所有注册用户的钱包地址及基础信息
model User {
  id        String   @id @default(cuid())   // 钱包地址，唯一
  address   String   @unique
  nickname  String?  @db.VarChar(100)       // 用户昵称
  email     String?  @unique                // 邮箱（可选）
  createdAt DateTime @default(now())        // 注册时间
  updatedAt DateTime @updatedAt             // 更新时间
  applications Application[]                // 用户的投递记录
  nftProofs    NFTProof[]                   // 用户的NFT证明

  @@index([nickname])
}

/// 岗位表，记录所有招聘岗位信息
model Job {
  id                  String           @id @default(cuid())
  title               String           // 岗位标题
  description         String           // 原始JD描述
  jobType             String           // 岗位类型
  weights             Json             // 各维度权重
  parsedRequirements  Json             // 解析后的结构化要求
  vectorMetadata      Json?            // 向量元数据（维度信息等）
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  resumeAnalyses      ResumeAnalysis[] // 关联的简历分析
  applications        Application[]    // 关联的投递记录
}

/// 简历分析表，记录简历与岗位的匹配分析结果
model ResumeAnalysis {
  id              String   @id @default(cuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeContent   String   // 原始简历内容
  parsedResume    Json     // 解析后的结构化简历数据
  totalScore      Float    // 总评分
  skillScore      Float    // 技能匹配分
  experienceScore Float    // 经验匹配分
  matchingPoints  Json     // 匹配要点
  suggestions     Json     // 改进建议
  recommended     Boolean  // 是否推荐
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 投递记录表，记录用户对岗位的投递行为
model Application {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  status    String   // 投递状态，如 pending, accepted, rejected
  createdAt DateTime @default(now())
}

/// NFT证明表，记录用户的链上成就/组织等证明
model NFTProof {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  nftType   String   // 成就/组织等类型
  tokenId   String   // 链上TokenId
  txHash    String   // 链上交易哈希
  mintedAt  DateTime // 铸造时间
} 